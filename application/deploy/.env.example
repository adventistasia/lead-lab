# Copy to .env beside compose.yaml. Never commit the filled-in .env.
# See ~/devops/projects/lead-lab/deployment/secrets-inventory.md for the
# full rationale on each of these.

# --- image ---
APP_IMAGE=ghcr.io/adventistasia/lead-lab:latest

# --- app ---
APP_NAME="Lead Lab"
APP_ENV=production
# Generate once with:
#   docker compose run --rm -e CONTAINER_ROLE=console -e APP_KEY=base64:placeholder \
#     app php artisan key:generate --show
# Cannot be rotated later without invalidating every session and making
# encrypted DB columns unreadable. Back this up together with the DB dump.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8087
TRUSTED_PROXIES=*

# --- database ---
DB_DATABASE=leadlab
DB_USERNAME=leadlab
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- mail ---
# Staging (chimera) runs Postmark SMTP; the values below are that shape. A
# throwaway Mailpit container (MAIL_HOST=mailpit, MAIL_PORT=1025, no
# credentials) is still fine for a local or disposable deploy.
#
# MAIL_MAILER is NOT read from here - compose.yaml hardcodes `smtp`. Keep it
# that way: Laravel's `postmark` transport needs symfony/postmark-mailer,
# which is not installed, and would fail at runtime. MAIL_SCHEME is not passed
# through at all, so switching to implicit TLS on 465 needs a compose change.
#
# For Postmark, username and password are BOTH the Server API token. That
# looks like a copy-paste error and is not.
#
# The From address must be a verified Sender Signature, or under a
# DKIM-verified domain, on the sending Postmark server - otherwise every send
# is rejected. Leaving it blank does NOT fail: compose.yaml falls back to the
# literal below, which is not verified on the SSD Postmark server.
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@leadlab.test
# MAIL_FROM_NAME is not set here - compose.yaml derives it from APP_NAME.
